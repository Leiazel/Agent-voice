# ==============================================================================
# CONFIGURACIÓN GENERAL
# ==============================================================================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ==============================================================================
# BASE DE DATOS Y DATOS FICTICIOS
# ==============================================================================
DATABASE_PATH=data/reservas.db
MENU_FILE_PATH=data/menu.json

# ==============================================================================
# PROVEEDOR DE LLM (gemini | ollama | groq | mock | liquid)
# ==============================================================================
LLM_PROVIDER=gemini

# Google Gemini (Capa gratuita oficial)
# Obtén tu clave en https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternativa Cloud gratuita de alta velocidad (Groq / OpenRouter)
# Obtén tu clave gratuita en https://console.groq.com/
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen/qwen3.8-27b

# Liquid AI (Modelos de decisión d1 / d1.1 / d1-ultra)
# Obtén tu clave en https://console.liquid.ai/
LIQUID_API_KEY=
LIQUID_BASE_URL=https://api.liquid.ai
LIQUID_MODEL=d1.1

# Ollama (Ejecución local opcional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ==============================================================================
# PIPELINE DE VOZ (PIPECAT / LOCAL)
# ==============================================================================
# Voice Activity Detection (VAD)
VAD_PROVIDER=silero

# Speech-to-Text (STT)
STT_PROVIDER=faster-whisper
STT_MODEL=base

# Text-to-Speech (TTS)
TTS_PROVIDER=piper
TTS_MODEL=es_ES-davefx-medium
