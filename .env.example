# ==============================================================================
# CONFIGURACIÓN GENERAL
# ==============================================================================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ==============================================================================
# BASE DE DATOS Y DATOS FICTICIOS
# ==============================================================================
DATABASE_PATH=data/reservas.db
MENU_FILE_PATH=data/menu.json

# ==============================================================================
# PROVEEDOR DE LLM (gemini | ollama)
# ==============================================================================
LLM_PROVIDER=gemini

# Google Gemini (Capa gratuita)
# Obtén tu clave en https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama (Ejecución local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ==============================================================================
# PIPELINE DE VOZ (PIPECAT / LOCAL)
# ==============================================================================
# Voice Activity Detection (VAD)
VAD_PROVIDER=silero

# Speech-to-Text (STT)
STT_PROVIDER=faster-whisper
STT_MODEL=base

# Text-to-Speech (TTS)
TTS_PROVIDER=piper
TTS_MODEL=es_ES-davefx-medium
